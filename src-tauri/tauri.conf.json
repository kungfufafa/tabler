{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabler",
  "version": "0.1.0",
  "identifier": "com.mekayastudio.tabler",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tabler",
        "width": 1280,
        "height": 820,
        "minWidth": 620,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 428 },
        "appPosition": { "x": 209, "y": 190 },
        "applicationFolderPosition": { "x": 451, "y": 190 }
      }
    },
    "fileAssociations": [
      {
        "ext": ["db", "sqlite", "sqlite3"],
        "name": "SQLite Database",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": ["sql"],
        "name": "SQL Script",
        "role": "Editor",
        "rank": "Default"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNEYzMkU2NzVBNEQ1OUYKUldTZjFhUjE1akpQLzB0NzdmUDkwUUN5ODdGZlVlNXZKODMzSzdjem9NbjZwL1RJSXdQU1pRRmQK",
      "endpoints": ["https://github.com/kungfufafa/tabler/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
