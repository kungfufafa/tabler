{
  "lex": {
    "identQuotes": [
      [
        "\"",
        "\""
      ]
    ],
    "stringQuotes": [
      "'"
    ],
    "readings": [
      {
        "stringBackslash": false,
        "identBackslash": false
      }
    ],
    "eStrings": true,
    "dollarQuotes": true,
    "dollarTags": true,
    "tripleQuotes": false,
    "rawPrefixes": false,
    "bytePrefixes": false,
    "hashComments": false,
    "slashSlashComments": false,
    "nestedBlockComments": true,
    "dashCommentNeedsSpace": false,
    "batchSeparator": null,
    "terminatorOptional": false,
    "beginEndBodies": false
  },
