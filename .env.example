# Copy to .env (gitignored). Used by `pnpm dev:db:seed` and Rust integration tests.
TABLER_TEST_PG_URL=postgres://apriansyahrs@127.0.0.1:5432/tabler_dev
TABLER_TEST_MYSQL_URL=mysql://root@127.0.0.1:3306/tabler_dev
TABLER_TEST_SQLITE_PATH=dev/fixtures/sample.sqlite
# SSH tunnel integration test (optional)
TABLER_TEST_SSH_HOST=127.0.0.1
TABLER_TEST_SSH_PORT=2222
TABLER_TEST_SSH_USER=tabler
TABLER_TEST_SSH_KEY=dev/ssh/tabler_dev
# "keychain" (default) or "file" (dev only: avoids repeated Keychain prompts on unsigned rebuilds)
TABLER_SECRETS_BACKEND=file
# Docker alternative (pnpm dev:db:up, see dev/README.md): uncomment to use the containers instead
# TABLER_TEST_PG_URL=postgres://tabler:tabler@127.0.0.1:54329/tabler_dev
# TABLER_TEST_MYSQL_URL=mysql://root:tabler@127.0.0.1:33069/tabler_dev
# Verification against real servers (src-tauri/tests/verify_servers.rs, see docs/verify-servers.md).
# Needs `sh dev/scripts/gen-certs.sh` and the compose services pg-ssl / mysql-ssl (profile "ssl"),
# mariadb (profile "mariadb") and ssh. Each test skips itself while its variable is unset.
# TABLER_TEST_PG_SSL_URL=postgres://tabler_cert@localhost:54339/tabler_dev
# TABLER_TEST_MYSQL_SSL_URL=mysql://tabler_x509@localhost:33089/tabler_dev
# TABLER_TEST_SSL_CERT_DIR=dev/certs
# TABLER_TEST_MARIADB_URL=mysql://root:tabler@127.0.0.1:33079/tabler_dev
# Database hosts as the SSH server sees them (compose network):
# TABLER_TEST_SSH_PG_URL=postgres://tabler:tabler@postgres:5432/tabler_dev
# TABLER_TEST_SSH_MYSQL_URL=mysql://root:tabler@mysql:3306/tabler_dev
# TABLER_TEST_SSH_PASSWORD=tabler   # optional: password auth instead of TABLER_TEST_SSH_KEY
# Driver lanes (docs/drivers/README.md): the real-server suites `node dev/scripts/lane.mjs <lane> it`
# runs (src-tauri/tests/<id>.rs). Each test skips itself while its variable is unset; each lane's
# brief (docs/drivers/<lane>.md) says how to get a server and the exact URL form.
# TABLER_TEST_CRDB_URL=postgres://root@127.0.0.1:26257/defaultdb
# TABLER_TEST_GREENPLUM_URL=postgres://gpadmin:gpadmin@127.0.0.1:5432/postgres
# TABLER_TEST_REDSHIFT_URL=postgres://admin:<password>@<workgroup>.<account>.<region>.redshift-serverless.amazonaws.com:5439/dev
# LibSQL: a local sqld over HTTP, or Turso as libsql://<db>-<org>.turso.io?authToken=<token>
# TABLER_TEST_LIBSQL_URL=http://127.0.0.1:8080
# D1: an API token with D1 Edit permission as the password, the account as the host
# TABLER_TEST_D1_URL=d1://:<api-token>@<account-id>/<database-name-or-uuid>
# TABLER_TEST_DUCKDB_PATH=dev/fixtures/sample.duckdb
# TABLER_TEST_CLICKHOUSE_URL=clickhouse://default@127.0.0.1:8123/default
# SQL Server: a SQL Server login over TCP with a port (no instance name); the suite encrypts and
# takes any certificate, so a default self-signed one is fine
# TABLER_TEST_SQLSERVER_URL=sqlserver://sa:<password>@127.0.0.1:1433/master
# TABLER_TEST_SNOWFLAKE_URL=snowflake://<user>@<account>/<database>
# TABLER_TEST_BIGQUERY_URL=bigquery://<project-id>
# TABLER_TEST_VERTICA_URL=vertica://dbadmin@127.0.0.1:5433/VMart
# TABLER_TEST_DYNAMODB_URL=dynamodb://<access-key-id>:<secret>@127.0.0.1:8000/us-east-1
# TABLER_TEST_CASSANDRA_URL=cassandra://127.0.0.1:9042/tabler_dev
# TABLER_TEST_REDIS_URL=redis://127.0.0.1:6379/0
# TABLER_TEST_MONGODB_URL=mongodb://127.0.0.1:27017/tabler_dev
# TABLER_TEST_ELASTICSEARCH_URL=elasticsearch://127.0.0.1:9200
